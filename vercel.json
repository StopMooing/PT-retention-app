{
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pt-retention-app.vercel.app"
        }
      ],
      "destination": "https://unfnshd.app/$1",
      "permanent": true
    }
  ]
}
